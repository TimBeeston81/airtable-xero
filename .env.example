# Xero Custom Connection (client_credentials grant), scoped to accounting.invoices and accounting.contacts
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Xero webhook signing key, from the webhook subscription in the Xero Developer Portal
XERO_WEBHOOK_KEY=

# Xero chart of accounts code that all invoice line items post against
XERO_LINE_ITEM_ACCOUNT_CODE=200

# Airtable Personal Access Token, needs read/write on the WareHouse base
AIRTABLE_PAT=
AIRTABLE_BASE_ID=apptEMZRI7Ap99uFc

# Shared secret the Airtable Automation sends in the x-webhook-secret header
# when calling sync-invoice-to-xero. Mint your own random value.
WAREHOUSE_WEBHOOK_SECRET=

# Airtable PAT scoped ONLY to the HYH & TISC UK base's Support Tickets table (write access) —
# used by sync-task-status.mts to write a mapped Status back onto the Ticket that originally
# created a WareHouse Task. Deliberately separate from AIRTABLE_PAT above (WareHouse-only) to
# keep token scope narrow per base.
HYH_TICKETS_AIRTABLE_TOKEN=

# Pushover notifications (notify-new-task.mts) — alerts Tim's phone when a client base adds a Task.
# App token: pushover.net → "Create an Application/API Token". User key: shown on the pushover.net dashboard.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
