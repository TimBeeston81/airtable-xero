# Your Xero DEMO COMPANY custom connection. Never commit the filled-in .env.demo.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Account codes that exist in the demo company's chart of accounts:
# the sales account the invoice lines are coded to, and where card payments land.
XERO_LINE_ITEM_ACCOUNT_CODE=200
XERO_STRIPE_ACCOUNT_CODE=
# Used only if you also run the functions here: the secret WareHouse sends.
WAREHOUSE_WEBHOOK_SECRET=
